{
  "name": "@onemessagebus/sdk",
  "version": "0.0.0-dev",
  "description": "Typed TypeScript client for the onemessagebus message bus: every capability of the CLI, over a subprocess or the resident core.",
  "keywords": ["ndjson", "message-bus", "queue", "schema", "sdk"],
  "homepage": "https://github.com/nickderobertis/onemessagebus",
  "bugs": "https://github.com/nickderobertis/onemessagebus/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickderobertis/onemessagebus.git",
    "directory": "npm/onemessagebus-sdk"
  },
  "license": "MIT",
  "author": "Nick DeRobertis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "format": "biome format --write src test scripts",
    "format:check": "biome format src test scripts",
    "lint": "biome lint src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --coverage --timeout 60000",
    "build": "tsc -p tsconfig.build.json",
    "pack": "tsc -p tsconfig.build.json && node scripts/pack.mjs",
    "test:package": "tsc -p tsconfig.build.json && node scripts/package-e2e.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "@types/node": "26.5.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "nx": {
    "includedScripts": []
  }
}
