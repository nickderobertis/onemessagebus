{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "npm/**/*.js",
      "npm/**/*.mjs",
      "npm/**/*.json",
      "scripts/**/*.mjs",
      "parity/**/*.mjs",
      "parity/**/*.json",
      "sdk-install/**/*.mjs",
      "sdk-install/**/*.json",
      "!npm/onemessagebus-sdk"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": { "enabled": false }
}
