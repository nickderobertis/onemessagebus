#!/usr/bin/env bash
# Build the publishable package and prove it installs: `just python-sdk-dist` packs a
# copy with every placeholder version stamped from Cargo.toml and builds its sdist
# and wheel into dist/packages; the wheel is read as the zip it is for the py.typed
# marker and the `Typing :: Typed` classifier the manifest promises, then installed
# into a fresh virtualenv beside pydantic (the onemessagebus-cli pin is the
# release's, installed by a user's resolver) and imported. Quiet on success but for
# one line; each failure names what to do next.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$here"
unset VIRTUAL_ENV
fail() { echo "build: $1" >&2; exit 1; }
venv="$here/dist/smoke-venv"
rm -rf "$here/dist/packages" "$venv"
just python-sdk-dist "$here/dist/packages" \
  || fail "the package did not build — the python-sdk-dist output above says why"
shopt -s nullglob
wheels=("$here"/dist/packages/onemessagebus-*.whl)
[ "${#wheels[@]}" -eq 1 ] \
  || fail "dist/packages holds ${#wheels[@]} onemessagebus wheels where the build leaves one; rerun this script, which empties it first"
uv venv --quiet "$venv" \
  || fail "cannot create the smoke virtualenv at $venv — install uv (https://docs.astral.sh/uv/) and a Python 3.10+, then rerun"
uv pip install --quiet --python "$venv/bin/python" --no-deps "${wheels[0]}" \
  || fail "the built wheel ${wheels[0]} did not install — the uv output above names what it refused"
uv pip install --quiet --python "$venv/bin/python" "pydantic>=2.7,<3" \
  || fail "pydantic did not install into the smoke virtualenv — check the package index is reachable, then rerun"
WHEEL="${wheels[0]}" "$venv/bin/python" - <<'EOF'
import json
import os
import sys
import zipfile
from pathlib import Path

REGENERATE = "run `just python-sdk-generate`, then build again"


def refuse(problem: str, action: str) -> None:
    sys.exit(f"build: {problem}\n  fix: {action}")


# The marker and the classifier are held on the wheel itself, never the source tree:
# the classifier is a promise that a consumer's type checker reads every name rather
# than Any, and only the wheel's contents say whether the release keeps it.
wheel = Path(os.environ["WHEEL"])
with zipfile.ZipFile(wheel) as archive:
    members = {info.filename: info.file_size for info in archive.infolist()}
    metadata = next((name for name in members if name.endswith(".dist-info/METADATA")), None)
    if metadata is None:
        refuse(f"{wheel.name} holds no .dist-info/METADATA", "rerun this script, which rebuilds it")
    classifiers = archive.read(metadata).decode("utf-8").splitlines()
if members.get("onemessagebus/py.typed") is None:
    refuse(
        f"{wheel.name} ships no onemessagebus/py.typed, so a consumer's type checker reads "
        "every name as Any",
        "restore the empty marker at src/onemessagebus/py.typed, then build again",
    )
if members["onemessagebus/py.typed"] != 0:
    refuse(
        f"{wheel.name}'s onemessagebus/py.typed holds {members['onemessagebus/py.typed']} bytes "
        "where the marker is empty",
        "empty src/onemessagebus/py.typed, then build again",
    )
if "Classifier: Typing :: Typed" not in classifiers:
    refuse(
        f"{wheel.name}'s METADATA carries no `Classifier: Typing :: Typed`",
        'restore "Typing :: Typed" under [project].classifiers in pyproject.toml, then build again',
    )

try:
    import onemessagebus
    from onemessagebus import models
    from onemessagebus._manifest import CAPABILITIES
except Exception as error:  # any import failure is the wheel's, and is reported as one
    refuse(f"the installed wheel does not import: {error!r}", REGENERATE)

stamped = onemessagebus.__version__
if stamped != onemessagebus.CLI_VERSION or stamped == "0.0.0.dev0":
    refuse(
        f"the wheel's __version__ is {stamped} and its CLI_VERSION {onemessagebus.CLI_VERSION}, "
        "not one stamped version",
        "run `uv run --no-project python scripts/pack.py` and restore the placeholder it names",
    )
manifest = Path("src/onemessagebus/_generated/capabilities.json")
try:
    checkout = {entry["method"] for entry in json.loads(manifest.read_text(encoding="utf-8"))}
except (OSError, ValueError, KeyError, TypeError) as error:
    refuse(f"cannot read the checkout's capability manifest at {manifest}: {error!r}", REGENERATE)
if set(CAPABILITIES) != checkout:
    refuse(
        "the wheel's capability manifest and the checkout's differ by "
        f"{sorted(set(CAPABILITIES) ^ checkout)}",
        REGENERATE,
    )
if models.PlannerSurface.__name__ != "Surface":
    refuse(
        f"the wheel's models.PlannerSurface is {models.PlannerSurface.__name__}, "
        "not the generated Surface model",
        REGENERATE,
    )
print(f"build: onemessagebus {stamped} wheel is typed, installs and imports")
EOF
