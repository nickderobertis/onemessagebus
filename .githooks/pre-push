#!/usr/bin/env bash
# The screencomp visual guard, and the only hook this directory carries: `just
# gate` is deliberately not wired in here. Re-capture when a [guard].paths file
# changes and block the push on drift, so the refreshed baseline is committed
# deliberately and CI stays green. Why, and how this is activated:
# screenshots/AGENTS.md.
#
# Bypass one push: git push --no-verify
set -euo pipefail

LANE="$(bash screenshots/host-arch.sh)"
MANIFEST="shots/baseline/${LANE}.json"     # the lane's committed baseline
GALLERY="shots/review"                     # [guard].gallery (review output)
CURRENT="shots/current"                    # capture root, mirrors visual-docs.yml

# No-op under CI: the visual-docs workflow is the source of truth there.
[ -n "${CI:-}" ] && exit 0

# llmlint: ignore[cli_output_contract] a pre-push hook's exit status is the push
# decision, not a report on the hook: an optional third-party tool that a clean
# clone's `just bootstrap` does not install must not block every contributor's
# push, and CI's strict gate is the backstop that catches what was skipped here.
# The skip is loud on stderr and SCREENCOMP_GUARD_REQUIRE=1 makes it fatal.
if ! command -v screencomp >/dev/null 2>&1; then
  {
    echo "pre-push: screencomp is NOT on PATH — the visual guard cannot run."
    echo "          Install it: https://github.com/nickderobertis/screencomp#install"
    echo "          Set SCREENCOMP_GUARD_REQUIRE=1 to fail here instead."
  } >&2
  [ -n "${SCREENCOMP_GUARD_REQUIRE:-}" ] && exit 1
  exit 0
fi

# The declared [capture].arches lanes, read from the one place they live. This is
# the guard's own input, so a screencomp that failed or answered nothing is a
# refusal rather than an empty lane set that would refuse this host by the wrong
# name.
if ! LANES="$(screencomp arches)" || [ -z "${LANES//[[:space:]]/}" ]; then
  echo "pre-push: 'screencomp arches' named no capture lane, so there is nothing" >&2
  echo "          to classify this host against. Check [capture].arches in" >&2
  echo "          screencomp.toml and that screencomp is current." >&2
  exit 1
fi

# A host whose arch no lane declares has no committed baseline and no CI job, so
# refuse loudly rather than classify against somebody else's lane.
if ! printf '%s\n' "$LANES" | grep -qxF "$LANE"; then
  echo "pre-push: this host's architecture ($LANE) has no lane in [capture].arches" >&2
  echo "          of screencomp.toml, so it has no committed baseline to classify" >&2
  echo "          against. Declared: $(printf '%s' "$LANES" | tr '\n' ' ')" >&2
  echo "          Add \"$LANE\" there (CI fans one job out per lane), capture it" >&2
  echo "          with 'just screenshots-bless', and commit $MANIFEST." >&2
  exit 1
fi

# git hands a pre-push hook one line per ref it is about to update, on stdin.
ranges=()
if [ -n "${SCREENCOMP_GUARD_RANGE:-}" ]; then
  ranges+=("$SCREENCOMP_GUARD_RANGE")   # test/override: diff this range directly
else
  zero='^0+$'
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    if [[ "$local_sha" =~ $zero ]]; then
      continue                            # branch deletion: nothing to capture
    elif [[ "$remote_sha" =~ $zero ]]; then
      base="$(git merge-base origin/HEAD "$local_sha" 2>/dev/null || true)"
      [ -n "$base" ] && ranges+=("${base}..${local_sha}") || ranges+=("$local_sha")
    else
      ranges+=("${remote_sha}..${local_sha}")
    fi
  done
fi
[ "${#ranges[@]}" -eq 0 ] && exit 0

changed="$(for r in "${ranges[@]}"; do git diff --name-only "$r"; done | sort -u)"

# `scope` exits 3 when a changed path matches [guard].paths, 0 when none do, and
# any OTHER non-zero on error. Treat ONLY exit 3 as relevant; on an error, warn
# and skip rather than force a slow capture — CI is the backstop.
set +e
printf '%s\n' "$changed" | screencomp scope --changed-from - --exit-code --quiet
scope_status=$?
set -e
case "$scope_status" in
  0) exit 0 ;;                            # nothing relevant: pass silently
  3) : ;;                                 # a relevant path matched: capture below
  # llmlint: ignore[cli_output_contract] same reasoning as the missing-CLI skip
  # above: the exit status is the push decision, a screencomp too old to answer
  # `scope` is not this push's fault, and CI's strict gate still catches the
  # drift. Forcing the slow capture instead would punish every push for a
  # version skew.
  *)
    echo "pre-push: 'screencomp scope' failed (exit $scope_status); skipping the" >&2
    echo "          visual guard. Is screencomp current? CI still gates this." >&2
    exit 0
    ;;
esac

if ! command -v freeze >/dev/null 2>&1; then
  echo "pre-push: screenshot-relevant files changed but 'freeze' is not installed" >&2
  echo "          to re-capture. Install it: just screenshots-tools" >&2
  echo "          then retry, or bypass with: git push --no-verify" >&2
  exit 1
fi
SHOTS_OUT="$CURRENT/$LANE" bash screenshots/capture.sh

set +e
screencomp classify --baseline-manifest "$MANIFEST" --current "$CURRENT" --arch "$LANE" --exit-code
status=$?
set -e

if [ "$status" -eq 0 ]; then
  echo "pre-push: screenshots unchanged against $MANIFEST — ok to push"
  exit 0
elif [ "$status" -ne 3 ]; then
  echo "pre-push: screencomp classify failed (exit $status)" >&2
  exit "$status"
fi

# Drift (exit 3): re-bless this lane and render it for review, then refuse — so
# the refreshed baseline and README images are committed deliberately.
SHOTS_CURRENT="$CURRENT" bash screenshots/bless-baseline.sh   # rewrites $MANIFEST
screencomp gallery --input "$CURRENT" --arch "$LANE" \
  --output "$GALLERY" --title "Pre-push screenshot review" >/dev/null

{
  echo
  echo "  SCREENSHOTS CHANGED — push blocked for review"
  echo "  Review the rendered gallery: $GALLERY/index.html"
  echo "  Also commit the refreshed README images in docs/screenshots/."
  echo "  If intended: git add $MANIFEST docs/screenshots && git commit, push again."
  echo "  If not: investigate the diff. Bypass with: git push --no-verify"
  echo
} >&2
exit 1
