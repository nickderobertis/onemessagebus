@@ -130,3 +130,16 @@ pub use vocabulary::{Admits, Open, Reserved, Vocabulary, Wire};
 #[doc = include_str!("../README.md")]
 #[cfg(doctest)]
 pub struct ReadmeDoctests;
+
+/// Spike-only capture hook (spikes/saphyr-diff/capture.sh applies and reverts it).
+#[doc(hidden)]
+pub fn __spike_capture(kind: &str, text: &str) {
+    if let Some(dir) = std::env::var_os("SPIKE_YAML_CAPTURE") {
+        use sha2::Digest;
+        let digest = sha2::Sha256::digest(text.as_bytes());
+        let name: String = digest.iter().take(8).map(|b| format!("{b:02x}")).collect();
+        let dir = std::path::Path::new(&dir).join(kind);
+        let _ = std::fs::create_dir_all(&dir);
+        let _ = std::fs::write(dir.join(format!("{name}.yaml")), text);
+    }
+}
