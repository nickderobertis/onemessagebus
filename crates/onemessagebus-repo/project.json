{
  "name": "onemessagebus-repo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "crates/onemessagebus-repo/tests",
  "tags": ["scope:repo", "lang:rust", "type:repo"],
  "implicitDependencies": [],
  "targets": {
    "bootstrap": { "command": "just _crate-bootstrap" },
    "format": { "command": "just _crate-format onemessagebus-repo" },
    "format-check": { "command": "just _crate-fmt-check onemessagebus-repo" },
    "lint": { "command": "just _crate-lint onemessagebus-repo" },
    "test": {
      "command": "just _crate-test onemessagebus-repo",
      "inputs": [
        "crateSource",
        "{workspaceRoot}/release-targets.toml",
        "{workspaceRoot}/scripts/release-probe.sh",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml"
      ]
    },
    "doc": { "command": "just _crate-doc onemessagebus-repo" },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test", "doc"]
    }
  }
}
