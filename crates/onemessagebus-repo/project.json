{
  "name": "onemessagebus-repo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "//": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] measured: both visual-docs journeys run in 0.27s with no build, no network and no install — the order of a test this target already carried. The tiers split behind their own edge each compile or install something first. `test`'s inputs name every root file these tests read, because Nx cannot see through an `include_str!`.",
  "projectType": "library",
  "sourceRoot": "crates/onemessagebus-repo/tests",
  "tags": ["scope:repo", "lang:rust", "type:repo"],
  "implicitDependencies": [],
  "targets": {
    "bootstrap": { "command": "just _crate-bootstrap" },
    "format": { "command": "just _crate-format onemessagebus-repo" },
    "format-check": { "command": "just _crate-fmt-check onemessagebus-repo" },
    "lint": { "command": "just _crate-lint onemessagebus-repo" },
    "test": {
      "command": "just _crate-test onemessagebus-repo",
      "inputs": [
        "crateSource",
        "{workspaceRoot}/release-targets.toml",
        "{workspaceRoot}/scripts/release-probe.sh",
        "{workspaceRoot}/clippy.toml",
        "{workspaceRoot}/rustfmt.toml",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/.github/workflows/visual-docs.yml",
        "{workspaceRoot}/.githooks/pre-push",
        "{workspaceRoot}/screenshots/*.sh",
        "{workspaceRoot}/screenshots/freeze.sha256",
        "{workspaceRoot}/screenshots/fixture/frames.json",
        "{workspaceRoot}/crates/onemessagebus-e2e/tests/layouts/desk.json",
        "{workspaceRoot}/crates/onemessagebus-e2e/tests/e2e/support.rs",
        "{workspaceRoot}/screencomp.toml"
      ]
    },
    "doc": { "command": "just _crate-doc onemessagebus-repo" },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test", "doc"]
    }
  }
}
