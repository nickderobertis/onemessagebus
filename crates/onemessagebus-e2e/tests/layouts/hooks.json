{
  "version": "1.0",
  "description": "The layouts the hook journeys link: one whose preparation stamps a record, one that splits an offer onto a plain queue and a typed one, and one whose relay queue routes on what it is offered.",
  "schemas": [
    {
      "id": "hooks.note@1",
      "schema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "n": {
            "type": "number"
          },
          "noted_at": {
            "type": "integer",
            "minimum": 0
          },
          "r": {
            "type": "number"
          }
        }
      }
    }
  ],
  "layouts": [
    {
      "name": "stamped",
      "description": "A notebook whose notes are stamped when they are offered, beside a typed queue and a plain one.",
      "queues": [
        {
          "name": "notes",
          "schema": "hooks.note@1"
        },
        {
          "name": "typed",
          "schema": "hooks.note@1"
        },
        {
          "name": "elsewhere"
        }
      ],
      "prepare": {
        "notes": [
          {
            "stamp": {
              "member": "noted_at"
            }
          }
        ]
      }
    },
    {
      "name": "split",
      "description": "An inbox whose offers are split: what a record carries under `l` goes to a plain queue, and `r` with the text beside it to a typed one.",
      "queues": [
        {
          "name": "inbox"
        },
        {
          "name": "left"
        },
        {
          "name": "right",
          "schema": "hooks.note@1"
        }
      ],
      "prepare": {
        "inbox": [
          {
            "route": {
              "routes": [
                {
                  "queue": "left",
                  "on": [
                    "l"
                  ],
                  "take": [
                    "l"
                  ]
                },
                {
                  "queue": "right",
                  "on": [
                    "r"
                  ],
                  "take": [
                    "r",
                    "text"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "relay",
      "description": "An inbox routing what it carries under `m` to a relay, whose own preparation sends a record carrying `n` on to a sink.",
      "queues": [
        {
          "name": "inbox"
        },
        {
          "name": "relay"
        },
        {
          "name": "sink"
        }
      ],
      "prepare": {
        "inbox": [
          {
            "route": {
              "routes": [
                {
                  "queue": "relay",
                  "on": [
                    "m"
                  ],
                  "take": [
                    "m"
                  ]
                }
              ]
            }
          }
        ],
        "relay": [
          {
            "route": {
              "routes": [
                {
                  "queue": "relay",
                  "on": [
                    "m"
                  ],
                  "take": [
                    "m"
                  ]
                },
                {
                  "queue": "sink",
                  "on": [
                    "n"
                  ],
                  "take": [
                    "n"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
