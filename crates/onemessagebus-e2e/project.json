{
  "name": "onemessagebus-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "crates/onemessagebus-e2e/tests",
  "tags": ["scope:e2e", "lang:rust", "type:e2e"],
  "implicitDependencies": ["onemessagebus-cli", "onemessagebus"],
  "targets": {
    "bootstrap": { "command": "just _crate-bootstrap" },
    "format": { "command": "just _crate-format onemessagebus-e2e" },
    "format-check": { "command": "just _crate-fmt-check onemessagebus-e2e" },
    "lint": { "command": "just _crate-lint onemessagebus-e2e" },
    "test": {
      "command": "just _e2e-test",
      "dependsOn": [{ "projects": ["onemessagebus-cli"], "target": "build" }],
      "inputs": ["crateSource", "^crateSource"]
    },
    "doc": { "command": "just _crate-doc onemessagebus-e2e" },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test", "doc"]
    }
  }
}
